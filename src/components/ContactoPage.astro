---
import ImgContactMe from "../assets/ImgContactMe.jpg"
import { FaFacebook, FaInstagram, FaTwitter } from "react-icons/fa"
---

<div
  class="w-full max-w-6xl mx-auto flex flex-col lg:flex-row justify-between
         gap-10 items-center py-16 px-4 md:px-8"
>
  <!-- Imagen -->
  <div class="w-full lg:w-1/3 order-1 lg:order-none flex justify-center">
    <img
      src={ImgContactMe.src}
      alt="Imagen de contacto"
      class="rounded-tr-[40px] rounded-bl-[40px]
             w-full max-w-xs h-80 sm:h-96 object-cover
             shadow-lg shadow-black/40
             transition-transform duration-300
             hover:-translate-y-2 hover:shadow-2xl"
    />
  </div>

  <!-- Formulario -->
  <div class="w-full lg:w-1/3">
    <form
      id="contact-form"
      action="https://formspree.io/f/xldqprzn"
      method="POST"
      class="space-y-10"
    >
      <div>
        <input
          type="text"
          name="nombre"
          class="w-full bg-transparent border-b-2 border-gray-500
                 focus:outline-none focus:border-gray-200 pb-1
                 text-sm text-gray-100 placeholder:text-gray-500
                 transition-colors duration-200"
          placeholder="Nombre Completo"
          required
        />
      </div>

      <div>
        <input
          type="email"
          name="email"
          class="w-full bg-transparent border-b-2 border-gray-500
                 focus:outline-none focus:border-gray-200 pb-1
                 text-sm text-gray-100 placeholder:text-gray-500
                 transition-colors duration-200"
          placeholder="Correo Electrónico"
          required
        />
      </div>

      <div>
        <textarea
          name="mensaje"
          rows="3"
          class="w-full bg-transparent border-b-2 border-gray-500
                 focus:outline-none focus:border-gray-200 pb-1
                 text-sm text-gray-100 placeholder:text-gray-500
                 transition-colors duration-200 resize-none"
          placeholder="Mensaje"
          required
        ></textarea>
      </div>

      <input
        type="hidden"
        name="_subject"
        value="Nuevo mensaje desde la landing Jook"
      />

      <button
        type="submit"
        class="bg-white text-black px-10 py-3 rounded-full text-sm font-medium
               transition-all duration-300
               hover:bg-gray-200 hover:-translate-y-0.5 hover:shadow-lg
               active:scale-95"
      >
        Contáctanos
      </button>
    </form>
  </div>

  <!-- Info de contacto -->
  <div class="w-full lg:w-1/3 m-4 text-sm text-gray-100 space-y-10">
    <div>
      <h4 class="font-semibold">Contacto</h4>
      <p class="text-gray-300">Jookcucuta@gmail.com</p>
    </div>
    <div>
      <h4 class="font-semibold">Ubicación</h4>
      <p class="text-gray-300">Cúcuta, Norte de Santander</p>
    </div>
    <div>
      <h4 class="font-semibold">Redes Sociales</h4>
      <ul class="flex p-2 gap-4">
        <li>
          <FaFacebook className="w-8 h-8 transition-transform duration-200 hover:scale-110" />
        </li>
        <li>
          <FaInstagram className="w-8 h-8 transition-transform duration-200 hover:scale-110" />
        </li>
        <li>
          <FaTwitter className="w-8 h-8 transition-transform duration-200 hover:scale-110" />
        </li>
      </ul>
    </div>
  </div>
</div>

<!-- Modal de agradecimiento -->
<div
  id="thankyou-modal"
  class="hidden fixed inset-0 z-50 flex items-center justify-center
         bg-black/60 backdrop-blur-sm"
>
  <div
    class="bg-slate-900 border border-white/10 rounded-2xl px-8 py-6
           max-w-sm w-[90%] text-center shadow-2xl"
  >
    <h3 class="text-xl font-semibold mb-3">¡Gracias por contactarnos! 🎉</h3>
    <p class="text-sm text-gray-200 mb-6">
      Hemos recibido tu mensaje. Te responderemos lo antes posible.
    </p>
    <button
      id="close-thankyou"
      class="px-6 py-2 rounded-full bg-white text-black text-sm font-medium
             hover:bg-gray-200 transition-colors"
    >
      Cerrar
    </button>
  </div>
</div>

<script is:inline>
  if (typeof window !== "undefined") {
    window.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("contact-form");
      const modal = document.getElementById("thankyou-modal");
      const closeBtn = document.getElementById("close-thankyou");

      if (!form || !modal || !closeBtn) return;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const submitButton = form.querySelector('button[type="submit"]');
        if (submitButton) submitButton.disabled = true;

        const formData = new FormData(form);

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: {
              Accept: "application/json",
            },
          });

          if (response.ok) {
            form.reset();
            modal.classList.remove("hidden");
          } else {
            alert("Ocurrió un error al enviar el mensaje. Inténtalo de nuevo.");
          }
        } catch (error) {
          alert("Error de conexión. Inténtalo de nuevo.");
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      });

      const closeModal = () => {
        modal.classList.add("hidden");
      };

      closeBtn.addEventListener("click", closeModal);

      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    });
  }
</script>
