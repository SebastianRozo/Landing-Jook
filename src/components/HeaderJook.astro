---
import JookSimpleSINFONDO from "../assets/JookSimpleSINFONDO.svg";
---

<header class="fixed top-0 left-0 w-full flex flex-col items-center mt-2 px-4 z-50">
  {/* Barra principal */}
  <nav
    class="flex items-center justify-between gap-4
           px-4 sm:px-6 md:px-8 py-1.5 sm:py-2
           max-w-5xl w-full
           rounded-full bg-black/90 border border-white/10 shadow-xl backdrop-blur-md"
  >
    {/* Logo */}
    <a href="#Top" class="flex items-center gap-2 transition-transform hover:scale-105">
      <img
        src={JookSimpleSINFONDO.src}
        alt="Logo de Jook"
        class="w-20 h-20 md:w-16 md:h-16 object-contain"
      />
    </a>

    {/* Menú desktop */}
    <ul
      class="hidden md:flex flex-1 justify-center gap-10 lg:gap-16
             text-sm font-bold text-gray-200"
    >
      <li><a href="#Nosotros" class="hover:text-white transition-colors">Nosotros</a></li>
      <li><a href="#Tecnologias" class="hover:text-white transition-colors">Tecnologías</a></li>
      <li><a href="#Servicios" class="hover:text-white transition-colors">Servicios</a></li>
      <li><a href="#Clientes" class="hover:text-white transition-colors">Clientes</a></li>
    </ul>

    {/* Botón desktop */}
    <a href="#Contacto" class="hidden md:block">
      <button
        class="px-5 py-2 text-sm font-bold text-white border border-white/40 rounded-full
               hover:bg-white hover:text-black transition-colors"
      >
        Contáctanos
      </button>
    </a>

    {/* Botón hamburguesa (solo mobile) */}
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center gap-1
             w-10 h-10 rounded-full border border-white/30
             hover:bg-white/10 transition-colors"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="block w-4 h-[2px] bg-white rounded-full"></span>
      <span class="block w-4 h-[2px] bg-white rounded-full"></span>
      <span class="block w-4 h-[2px] bg-white rounded-full"></span>
    </button>
  </nav>

  {/* Menú mobile desplegable */}
  <div
    id="mobile-menu"
    class="md:hidden hidden mt-3 w-full max-w-5xl
           rounded-3xl bg-black/95 border border-white/10 shadow-xl
           px-6 py-4 space-y-4"
  >
    <ul class="flex flex-col gap-3 text-sm text-gray-200">
      <li>
        <a href="#Nosotros" class="block py-1 hover:text-white transition-colors">
          Nosotros
        </a>
      </li>
      <li>
        <a href="#Tecnologias" class="block py-1 hover:text-white transition-colors">
          Tecnologías
        </a>
      </li>
      <li>
        <a href="#Servicios" class="block py-1 hover:text-white transition-colors">
          Servicios
        </a>
      </li>
      <li>
        <a href="#Clientes" class="block py-1 hover:text-white transition-colors">
          Clientes
        </a>
      </li>
    </ul>

    <div class="pt-2 border-t border-white/10">
      <a href="#Contacto" class="block w-full">
        <button
          class="mt-3 w-full px-4 py-2 text-sm text-black bg-white rounded-full
                 font-medium hover:bg-gray-200 transition-colors"
        >
          Contáctanos
        </button>
      </a>
    </div>
  </div>

  <script is:inline>
    if (typeof window !== "undefined") {
      window.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("mobile-menu");

        if (!toggle || !menu) return;

        toggle.addEventListener("click", () => {
          const isHidden = menu.classList.contains("hidden");

          if (isHidden) {
            menu.classList.remove("hidden");
            toggle.setAttribute("aria-expanded", "true");
          } else {
            menu.classList.add("hidden");
            toggle.setAttribute("aria-expanded", "false");
          }
        });
      });
    }
  </script>
</header>
