---
import "../styles/global.css";
import { TechCarousel } from "../components/Carousel";
import HeaderJook from "../components/HeaderJook.astro";
import CardProjects from "../components/CardProjects.jsx";
import LogoFrontera from "../assets/LogoFrontera.png";
import ContactoPage from "@/components/ContactoPage.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Landing Jook</title>
  </head>

  <body class="min-h-screen font-sans">
    <main class="min-h-screen flex flex-col items-center justify-center gap-32">

         <HeaderJook/>

      <!-- Carousel de Tecnologías -->
      <TechCarousel client:load />

      <!-- Header de Jook -->


      <!-- Sección de Tecnologías -->
      <section class="text-center text-sm md:text-base">
        <p>Tecnologías que dominamos</p>
      </section>

      <!-- Sección de Empresas que confían en nosotros -->
      <section class="text-center text-sm md:text-base">
        <p>Empresas que confían en nosotros</p>
        <CardProjects
          img={LogoFrontera.src}
          Description="Empresa colombiana especializada en distribución y recarga de telefonía prepago. Líder local con innovación en canales digitales y gestión de puntos de venta."
          fecha="Colaborando desde 2024 a 2025"
        />
      </section>

      <!-- Sección de Contacto -->
      <section>
        <div class="flex justify-center text-5xl font-bold">
          <h2>Contáctanos y trabajemos juntos</h2>
        </div>
        <ContactoPage/>
      </section>

    </main>
  </body>
</html>
